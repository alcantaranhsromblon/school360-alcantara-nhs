# ---- Frontend (safe to expose: anon key is protected by Row Level Security) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---- Google Drive upload (Netlify function; set these in Netlify, NOT in the frontend) ----
GOOGLE_CLIENT_EMAIL=school360-uploader@your-project.iam.gserviceaccount.com
# paste the private_key value from the JSON key; keep the \n sequences, wrap in double quotes
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# link (or ID) of the Shared Drive folder where uploads go
DRIVE_FOLDER=https://drive.google.com/drive/folders/XXXXXXXXXXXXXXXX
# optional
# DRIVE_MAKE_PUBLIC=true
# DRIVE_MAX_MB=50

# ---- Seeding script ONLY (local; never commit, never put in Netlify) ----
SUPABASE_SERVICE_ROLE_KEY=
